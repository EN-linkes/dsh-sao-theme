{
  "name": "dsh-sao-theme",
  "version": "1.0.2",
  "description": "Sword Art Online / Aincrad style skin for DeepSeek Harness: holographic cyan system windows, corner brackets, scanline HUD, sharp-cornered HUD language, monospace numerals.",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EN-linkes/dsh-sao-theme.git"
  },
  "homepage": "https://github.com/EN-linkes/dsh-sao-theme#readme",
  "bugs": {
    "url": "https://github.com/EN-linkes/dsh-sao-theme/issues"
  },
  "author": "EN-linkes",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node dev.mjs",
    "audit": "node tools/audit.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "sao"
  ],
  "license": "MIT"
}
